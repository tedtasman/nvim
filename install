#!/usr/bin/env bash
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
NAME="${SCRIPT_DIR##*/}" 

if [ -e "$HOME/.config/$NAME" ]; then
    printf "$NAME already exists in ~/.config\n"
    exit 1
fi

ln -s "$SCRIPT_DIR" "$HOME/.config/$NAME" && printf "$NAME config installed\n"
